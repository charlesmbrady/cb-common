{
  "pluginsConfig": { "@nx/js": { "analyzeSourceFiles": true } },
  "extends": "nx/presets/npm.json",
  "packageManager": "yarn",
  "workspaceLayout": { "appsDir": "apps", "libsDir": "libs" },
  "plugins": [
    { "plugin": "@nx/eslint/plugin", "options": { "targetName": "lint" } },
    {
      "plugin": "@nx/webpack/plugin",
      "options": {
        "buildTargetName": "build",
        "serveTargetName": "serve",
        "previewTargetName": "preview"
      }
    },
    {
      "plugin": "@nx/cypress/plugin",
      "options": {
        "targetName": "e2e",
        "openTargetName": "open-cypress",
        "componentTestingTargetName": "component-test",
        "ciTargetName": "e2e-ci"
      }
    },
    {
      "plugin": "@nx/next/plugin",
      "options": {
        "buildTargetName": "build",
        "devTargetName": "dev",
        "serveStaticTargetName": "serve-static",
        "startTargetName": "start"
      }
    },
    {
      "plugin": "@nx/storybook/plugin",
      "options": {
        "serveStorybookTargetName": "storybook",
        "buildStorybookTargetName": "build-storybook",
        "testStorybookTargetName": "test-storybook",
        "staticStorybookTargetName": "static-storybook"
      }
    },
    { "plugin": "@nx/rollup/plugin", "options": { "buildTargetName": "build" } }
  ],
  "parallel": 3,
  "cacheDirectory": ".nx/cache",
  "defaultBase": "main",
  "namedInputs": {
    "default": ["{projectRoot}/**/*"],
    "production": [
      "!{projectRoot}/**/*.spec.tsx",
      "!{projectRoot}/**/*.spec.ts",
      "!{projectRoot}/**/*.test.ts",
      "!{projectRoot}/**/*.test.tsx",
      "!{projectRoot}/cypress/**/*",
      "!{projectRoot}/cypress.config.[jt]s",
      "!{projectRoot}/**/*.stories.@(js|jsx|ts|tsx|mdx)",
      "!{projectRoot}/.storybook/**/*",
      "!{projectRoot}/tsconfig.storybook.json"
    ]
  },
  "targetDefaults": {
    "@nx/js:tsc": {
      "inputs": ["production", "^production"],
      "dependsOn": ["^build"],
      "options": { "main": "{projectRoot}/src/index.ts" },
      "cache": true
    },
    "@nx/rollup:rollup": {
      "inputs": ["production", "^production"],
      "dependsOn": ["^build"],
      "cache": true
    },
    "@nx/vite:build": {
      "inputs": ["production", "^production"],
      "cache": true
    },
    "@nx/next:build": {
      "inputs": ["production", "^production"],
      "cache": true
    },
    "test": {
      "inputs": ["default", "^production", "{workspaceRoot}/jest.preset.js"],
      "outputs": ["{workspaceRoot}/coverage/{projectRoot}"]
    },
    "e2e-ci": { "dependsOn": ["^build"] },
    "e2e-ci--**/*": { "dependsOn": ["^build"] },
    "@nx/esbuild:esbuild": {
      "cache": true,
      "dependsOn": ["^build"],
      "inputs": ["production", "^production"]
    }
  },
  "release": {
    "version": {
      "preVersionCommand": "yarn nx run-many -t build",
      "generatorOptions": {
        "currentVersionResolver": "git-tag",
        "specifierSource": "conventional-commits"
      }
    },
    "changelog": {
      "git": { "commit": true, "tag": true },
      "workspaceChangelog": { "createRelease": "github" },
      "projectChangelogs": true
    }
  },
  "generators": {
    "@nx/react": {
      "application": {
        "babel": true,
        "style": "css",
        "linter": "eslint",
        "bundler": "vite",
        "port": 3333,
        "e2eTestRunner": "cypress",
        "appDir": true,
        "projectNameAndRootFormat": "as-provided",
        "routing": true,
        "pascalCaseFiles": true,
        "classComponent": false,
        "minimal": false,
        "compiler": "babel",
        "globalCss": false,
        "strict": true,
        "js": false,
        "unitTestRunner": "jest",
        "tags": "app,react",
        "targets": {
          "build": {
            "executor": "@nx/vite:build",
            "outputs": ["dist/apps/{projectName}"],
            "options": { "outputPath": "dist/apps/{projectName}" }
          },
          "serve": {
            "executor": "@nx/vite:dev-server",
            "options": { "buildTarget": "{projectName}:build" }
          },
          "test": {
            "executor": "@nx/jest:jest",
            "outputs": ["coverage/apps/{projectName}"],
            "options": {
              "jestConfig": "apps/{projectName}/jest.config.js",
              "passWithNoTests": true
            }
          }
        }
      },
      "service": {
        "project": "{projectName}",
        "name": "{serviceName}",
        "directory": "src/services",
        "flat": true
      },
      "hook": {
        "project": "{projectName}",
        "name": "{hookName}",
        "directory": "src/hooks",
        "pascalCaseFiles": false
      },
      "component": { "style": "css", "export": true },
      "storybook": {
        "linter": "eslint",
        "storybook7": true,
        "configureCypress": true,
        "tsConfiguration": true,
        "js": false,
        "generateStories": true,
        "generateCypressSpecs": true
      },
      "library": {
        "style": "css",
        "linter": "eslint",
        "unitTestRunner": "jest",
        "projectNameAndRootFormat": "as-provided",
        "libDir": true,
        "tags": "react",
        "bundler": "rollup",
        "targets": {
          "build": {
            "executor": "@nx/rollup:rollup",
            "outputs": ["dist/libs/{projectName}"],
            "options": { "outputPath": "dist/libs/{projectName}" }
          },
          "test": {
            "executor": "@nx/jest:jest",
            "outputs": ["coverage/libs/{projectName}"],
            "options": {
              "jestConfig": "libs/{projectName}/jest.config.js",
              "passWithNoTests": true
            }
          }
        }
      }
    },
    "@nx/next": {
      "application": {
        "linter": "eslint",
        "e2eTestRunner": "cypress",
        "projectNameAndRootFormat": "as-provided",
        "style": "css",
        "src": true,
        "tags": "app,next",
        "targets": {
          "test": {
            "executor": "@nx/jest:jest",
            "outputs": ["{workspaceRoot}/coverage/{projectRoot}"],
            "options": { "jestConfig": "{projectRoot}/jest.config.ts" }
          },
          "build": {
            "executor": "@nx/next:build",
            "outputs": ["{options.outputPath}"],
            "defaultConfiguration": "production",
            "options": { "outputPath": "dist/apps/{projectName}" },
            "configurations": {
              "production": { "outputPath": "dist/apps/{projectName}" },
              "development": { "outputPath": "{projectRoot}" }
            }
          },
          "serve": {
            "executor": "@nx/next:server",
            "defaultConfiguration": "development",
            "options": { "buildTarget": "{projectName}:build", "dev": true },
            "configurations": {
              "production": {
                "buildTarget": "{projectName}:build:production",
                "dev": false
              },
              "development": {
                "buildTarget": "{projectName}:build:development",
                "dev": true
              }
            }
          }
        }
      },
      "library": {
        "style": "css",
        "linter": "eslint",
        "unitTestRunner": "jest",
        "projectNameAndRootFormat": "as-provided",
        "libDir": true,
        "tags": "next",
        "targets": {
          "build": {
            "executor": "@nx/js:tsc",
            "outputs": ["dist/libs/{projectName}"],
            "options": {
              "outputPath": "dist/libs/{projectName}",
              "main": "libs/{projectName}/src/index.ts"
            }
          },
          "test": {
            "executor": "@nx/jest:jest",
            "outputs": ["coverage/libs/{projectName}"],
            "options": {
              "jestConfig": "libs/{projectName}/jest.config.js",
              "passWithNoTests": true
            }
          }
        }
      },
      "component": {
        "style": "css",
        "pascalCaseFiles": true,
        "export": true,
        "project": "{projectName}"
      },
      "service": {
        "project": "{projectName}",
        "name": "{serviceName}",
        "directory": "src/services",
        "flat": true
      },
      "storybook": {
        "linter": "eslint",
        "storybook7": true,
        "configureCypress": true,
        "tsConfiguration": true,
        "js": false,
        "generateStories": true,
        "generateCypressSpecs": true
      }
    },
    "@nx/node": {
      "application": {
        "linter": "eslint",
        "unitTestRunner": "jest",
        "e2eTestRunner": "none",
        "appDir": true,
        "compiler": "tsc",
        "pascalCaseFiles": true,
        "port": 3333,
        "projectNameAndRootFormat": "as-provided",
        "framework": "none",
        "docker": false,
        "tags": "app,node",
        "passWithNoTests": true,
        "targets": {
          "build": {
            "executor": "@nx/node:build",
            "outputs": ["dist/apps/{projectName}"],
            "options": { "outputPath": "dist/apps/{projectName}" }
          },
          "serve": {
            "executor": "@nx/node:execute",
            "options": { "buildTarget": "{projectName}:build" }
          },
          "test": {
            "executor": "@nx/jest:jest",
            "outputs": ["coverage/apps/{projectName}"],
            "options": {
              "jestConfig": "apps/{projectName}/jest.config.js",
              "passWithNoTests": true
            }
          }
        }
      },
      "library": {
        "linter": "eslint",
        "unitTestRunner": "jest",
        "tags": "node",
        "projectNameAndRootFormat": "as-provided",
        "targets": {
          "build": {
            "executor": "@nx/node:build",
            "outputs": ["dist/libs/{projectName}"],
            "options": { "outputPath": "dist/libs/{projectName}" }
          },
          "test": {
            "executor": "@nx/jest:jest",
            "outputs": ["coverage/libs/{projectName}"],
            "options": {
              "jestConfig": "libs/{projectName}/jest.config.js",
              "passWithNoTests": true
            }
          }
        }
      }
    },
    "@nx/js": {
      "library": {
        "linter": "eslint",
        "unitTestRunner": "jest",
        "strict": true,
        "projectNameAndRootFormat": "as-provided",
        "libDir": true,
        "bundler": "tsc",
        "js": false,
        "tags": "js",
        "targets": {
          "build": {
            "executor": "@nx/js:tsc",
            "outputs": ["dist/libs/{projectName}"],
            "options": {
              "outputPath": "dist/libs/{projectName}",
              "main": "libs/{projectName}/src/index.ts",
              "tsConfig": "libs/{projectName}/tsconfig.lib.json",
              "assets": ["libs/{projectName}/src/assets"]
            }
          },
          "test": {
            "executor": "@nx/jest:jest",
            "outputs": ["coverage/libs/{projectName}"],
            "options": {
              "jestConfig": "libs/{projectName}/jest.config.js",
              "passWithNoTests": true
            }
          }
        }
      }
    }
  },
  "nxCloudId": "6928ab3a6dbb120dbbd5dc88"
}
