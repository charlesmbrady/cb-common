{
  "name": "mockdat-svc",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "libs/mockdat-svc/src",
  "projectType": "library",
  "tags": ["node"],
  "targets": {
    "build": {
      "executor": "@nx/js:tsc",
      "outputs": ["{options.outputPath}"],
      "options": {
        "outputPath": "dist/libs/mockdat-svc",
        "tsConfig": "libs/mockdat-svc/tsconfig.lib.json",
        "packageJson": "libs/mockdat-svc/package.json",
        "main": "libs/mockdat-svc/src/index.ts",
        "assets": ["libs/mockdat-svc/*.md"]
      }
    },
    "test": {
      "executor": "@nx/jest:jest",
      "outputs": ["{workspaceRoot}/coverage/{projectRoot}"],
      "options": {
        "jestConfig": "libs/mockdat-svc/jest.config.ts"
      }
    }
  }
}
