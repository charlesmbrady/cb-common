{
  "name": "lambda",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "libs/lambda/src",
  "projectType": "library",
  "tags": ["node"],
  "targets": {
    "build": {
      "executor": "@nx/js:tsc",
      "outputs": ["{options.outputPath}"],
      "options": {
        "outputPath": "dist/libs/lambda",
        "tsConfig": "libs/lambda/tsconfig.lib.json",
        "packageJson": "libs/lambda/package.json",
        "main": "libs/lambda/src/index.ts",
        "assets": ["libs/lambda/*.md", "libs/lambda/src/lib/mock/*.json"]
      }
    },
    "test": {
      "executor": "@nx/jest:jest",
      "outputs": ["{workspaceRoot}/coverage/{projectRoot}"],
      "options": {
        "jestConfig": "libs/lambda/jest.config.ts"
      }
    }
  }
}
