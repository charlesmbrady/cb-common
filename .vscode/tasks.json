// .vscode/tasks.json
{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "TEST: Deploy services Lambda",
      "type": "shell",
      "command": "${workspaceFolder}/scripts/deploy_lambda.sh",
      "args": [
        "--env",
        "test",
        "--nx-project-name",
        "api-services",
        "--lambda-name",
        "charlesmbrady_api_services_Test"
      ],
      "problemMatcher": [],
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "presentation": {
        "echo": true,
        "reveal": "always",
        "focus": false,
        "panel": "shared",
        "showReuseMessage": true,
        "clear": false
      }
    },
    {
      "label": "PROD: Deploy services Lambda",
      "type": "shell",
      "command": "${workspaceFolder}/scripts/deploy_lambda.sh",
      "args": [
        "--env",
        "production",
        "--nx-project-name",
        "api-services",
        "--lambda-name",
        "charlesmbrady_api_services_Production"
      ],
      "problemMatcher": [],
      "group": {
        "kind": "build",
        "isDefault": false
      },
      "presentation": {
        "echo": true,
        "reveal": "always",
        "focus": false,
        "panel": "shared",
        "showReuseMessage": true,
        "clear": false
      }
    },
    // Build and Deploy tasks for charlesmbrady
    {
      "label": "Build: charlesmbrady",
      "type": "shell",
      "command": "yarn nx build charlesmbrady",
      "problemMatcher": []
    },
    {
      "label": "Deploy: charlesmbrady Test",
      "type": "shell",
      "command": "./scripts/deploy_app.sh",
      "args": [
        "--project-name",
        "charlesmbrady-web",
        "--bucket-name",
        "charlesmbrady-test-website-content",
        "--configuration",
        "test"
      ],
      "dependsOn": ["Build: charlesmbrady-web"],
      "problemMatcher": []
    },
    {
      "label": "Deploy: charlesmbrady Prod",
      "type": "shell",
      "command": "./scripts/deploy_app.sh",
      "args": [
        "--project-name",
        "charlesmbrady-web",
        "--bucket-name",
        "charlesmbrady-production-website-content",
        "--configuration",
        "production"
      ],
      "dependsOn": ["Build: charlesmbrady-web"],
      "problemMatcher": []
    },
    // Build and Deploy tasks for mockdat-web
    {
      "label": "Build: mockdat-web",
      "type": "shell",
      "command": "yarn nx build mockdat-web",
      "problemMatcher": []
    },
    {
      "label": "Deploy: mockdat-web Test",
      "type": "shell",
      "command": "./scripts/deploy_app.sh",
      "args": [
        "--project-name",
        "mockdat-web",
        "--bucket-name",
        "mockdat-test-website-content",
        "--configuration",
        "test"
      ],
      "dependsOn": ["Build: mockdat-web"],
      "problemMatcher": []
    },
    {
      "label": "Deploy: mockdat-web Prod",
      "type": "shell",
      "command": "./scripts/deploy_app.sh",
      "args": [
        "--project-name",
        "mockdat-web",
        "--bucket-name",
        "mockdat-production-website-content",
        "--configuration",
        "production"
      ],
      "dependsOn": ["Build: mockdat-web"],
      "problemMatcher": []
    },
    // Build and Deploy tasks for apps
    {
      "label": "Build: apps",
      "type": "shell",
      "command": "yarn nx build apps",
      "problemMatcher": []
    },
    {
      "label": "Deploy: apps Test",
      "type": "shell",
      "command": "./scripts/deploy_app.sh",
      "args": [
        "--project-name",
        "apps",
        "--bucket-name",
        "apps-test-website-content",
        "--configuration",
        "test"
      ],
      "dependsOn": ["Build: apps"],
      "problemMatcher": []
    },
    {
      "label": "Deploy: apps Prod",
      "type": "shell",
      "command": "./scripts/deploy_app.sh",
      "args": [
        "--project-name",
        "apps",
        "--bucket-name",
        "apps-production-website-content",
        "--configuration",
        "production"
      ],
      "dependsOn": ["Build: apps"],
      "problemMatcher": []
    }
  ]
}
