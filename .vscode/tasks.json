// .vscode/tasks.json
{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "TEST: Deploy services Lambda",
      "type": "shell",
      "command": "${workspaceFolder}/scripts/deploy_lambda.sh",
      "args": [
        "--lambda-name",
        "charlesmbrady_Test_services_middleware",
        "--nx-project",
        "api-services",
        "--build",
        "--verbose"
      ],
      "problemMatcher": [],
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "presentation": {
        "echo": true,
        "reveal": "always",
        "focus": false,
        "panel": "shared",
        "showReuseMessage": true,
        "clear": false
      }
    },
    {
      "label": "PROD: Deploy services Lambda",
      "type": "shell",
      "command": "${workspaceFolder}/scripts/deploy_lambda.sh",
      "args": [
        "--lambda-name",
        "charlesmbrady_Production_services_middleware",
        "--nx-project",
        "api-services",
        "--build",
        "--verbose"
      ],
      "problemMatcher": [],
      "group": {
        "kind": "build",
        "isDefault": false
      },
      "presentation": {
        "echo": true,
        "reveal": "always",
        "focus": false,
        "panel": "shared",
        "showReuseMessage": true,
        "clear": false
      }
    },
    // Build and Deploy tasks for charlesmbrady
    {
      "label": "Build: charlesmbrady",
      "type": "shell",
      "command": "yarn nx build charlesmbrady",
      "problemMatcher": []
    },
    {
      "label": "Deploy: charlesmbrady Test",
      "type": "shell",
      "command": "./scripts/deploy_app.sh",
      "args": ["charlesmbrady", "charlesmbrady-test-website-content"],
      "dependsOn": ["Build: charlesmbrady"],
      "problemMatcher": []
    },
    {
      "label": "Deploy: charlesmbrady Prod",
      "type": "shell",
      "command": "./scripts/deploy_app.sh",
      "args": ["charlesmbrady", "charlesmbrady-production-website-content"],
      "dependsOn": ["Build: charlesmbrady"],
      "problemMatcher": []
    },
    // Build and Deploy tasks for mockdat-web
    {
      "label": "Build: mockdat-web",
      "type": "shell",
      "command": "yarn nx build mockdat-web",
      "problemMatcher": []
    },
    {
      "label": "Deploy: mockdat-web Test",
      "type": "shell",
      "command": "./scripts/deploy_app.sh",
      "args": [
        "--verbose",
        "--type",
        "react",
        "mockdat-web",
        "mockdat-test-website-content"
      ],
      "dependsOn": ["Build: mockdat-web"],
      "problemMatcher": []
    },
    {
      "label": "Deploy: mockdat-web Prod",
      "type": "shell",
      "command": "./scripts/deploy_app.sh",
      "args": [
        "--type",
        "react",
        "mockdat-web",
        "mockdat-production-website-content"
      ],
      "dependsOn": ["Build: mockdat-web"],
      "problemMatcher": []
    },
    // Build and Deploy tasks for labs
    {
      "label": "Build: labs",
      "type": "shell",
      "command": "yarn nx build labs",
      "problemMatcher": []
    },
    {
      "label": "Deploy: labs Test",
      "type": "shell",
      "command": "./scripts/deploy_app.sh",
      "args": ["--type", "react", "labs", "labs-test-website-content"],
      "dependsOn": ["Build: labs"],
      "problemMatcher": []
    },
    {
      "label": "Deploy: labs Prod",
      "type": "shell",
      "command": "./scripts/deploy_app.sh",
      "args": ["--type", "react", "labs", "labs-production-website-content"],
      "dependsOn": ["Build: labs"],
      "problemMatcher": []
    }
  ]
}
