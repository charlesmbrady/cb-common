// .vscode/tasks.json
{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "TEST: Deploy services Lambda",
      "type": "shell",
      "command": "${workspaceFolder}/scripts/deploy_lambda.sh",
      "args": [
        "--lambda-name",
        "charlesmbrady_Test_services_middleware",
        "--nx-project",
        "api-services",
        "--build",
        "--verbose"
      ],
      "problemMatcher": [],
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "presentation": {
        "echo": true,
        "reveal": "always",
        "focus": false,
        "panel": "shared",
        "showReuseMessage": true,
        "clear": false
      }
    }
  ]
}
