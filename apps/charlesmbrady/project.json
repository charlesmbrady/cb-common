{
  "name": "charlesmbrady",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "apps/charlesmbrady",
  "projectType": "application",
  "tags": ["app", "next"],
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "options": {
        "commands": [
          {
            "command": "nx run charlesmbrady:next-build && mkdir -p dist/apps/charlesmbrady && [ -d tmp/apps/charlesmbrady/.next ] && cp -r tmp/apps/charlesmbrady/.next/* dist/apps/charlesmbrady/ || echo 'No .next directory to copy'"
          }
        ]
      },
      "configurations": {
        "test": {},
        "production": {}
      }
    },
    "next-build": {
      "executor": "@nx/next:build",
      "outputs": ["{workspaceRoot}/tmp/charlesmbrady"],
      "options": {
        "outputPath": "{workspaceRoot}/tmp/apps/charlesmbrady"
      }
    },
    "test": {
      "executor": "@nx/jest:jest",
      "outputs": ["{workspaceRoot}/coverage/{projectRoot}"],
      "options": {
        "jestConfig": "apps/charlesmbrady/jest.config.ts"
      }
    }
  }
}
