{
  "name": "api-services",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "apps/api-services/src",
  "projectType": "application",
  "tags": ["app", "node"],
  "targets": {
    "version": {
      "executor": "@jscutlery/semver:version",
      "options": {
        "preset": "conventional",
        "baseBranch": "master",
        "allowEmptyRelease": true,
        "push": true,
        "postTargets": ["api-services:github"]
      }
    },
    "github": {
      "executor": "@jscutlery/semver:github",
      "options": {
        "tag": "{tag}",
        "notes": "{notes}"
      }
    },
    "build": {
      "executor": "@nx/esbuild:esbuild",
      "outputs": ["{options.outputPath}"],
      "defaultConfiguration": "production",
      "options": {
        "platform": "node",
        "outputPath": "dist/apps/api-services",
        "format": ["cjs"],
        "bundle": false,
        "main": "apps/api-services/src/main.ts",
        "tsConfig": "apps/api-services/tsconfig.app.json",
        "assets": [
          "apps/api-services/src/assets",
          "libs/lambda/src/lib/mock/*.json"
        ],
        "generatePackageJson": true,
        "esbuildOptions": {
          "sourcemap": true,
          "outExtension": {
            ".js": ".js"
          }
        }
      },
      "configurations": {
        "development": {},
        "production": {
          "esbuildOptions": {
            "sourcemap": false,
            "outExtension": {
              ".js": ".js"
            }
          }
        }
      }
    },
    "serve": {
      "executor": "nx:run-commands",
      "options": {
        "command": "npx nodemon -w ./apps/api-services/src --ext ts --exec \"nx run api-services:build:development && NODE_ENV=development LOCAL_SERVER=true node dist/apps/api-services/main.js\"",
        "cwd": "."
      }
    },
    "test": {
      "options": {
        "passWithNoTests": true
      }
    }
  }
}
